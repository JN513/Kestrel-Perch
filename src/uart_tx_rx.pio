.program uart_tx
.side_set 1 opt

; TX Pin em side-set
pull block          side 1 [7]
out null, 24        side 1
set x, 7            side 0 [7]  ; Start bit
bitloop:
    out pins, 1            [6]  ; Data bits
    jmp x-- bitloop        [1]

% c-sdk {
#include "hardware/clocks.h"

static inline void uart_tx_program_init(PIO pio, uint sm, uint offset, uint pin_tx, uint baud) {
    pio_sm_config c = uart_tx_program_get_default_config(offset);
    sm_config_set_out_pins(&c, pin_tx, 1);
    sm_config_set_sideset_pins(&c, pin_tx);
    pio_gpio_init(pio, pin_tx);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_tx, 1, true);
    
    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);
    
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}

.program uart_rx

; RX Pin em in_pins
wait 0 pin 0
set x, 7            [12]
bitloop:
    in pins, 1             [6]
    jmp x-- bitloop        [1]
jmp pin rx_ok
rx_ok:
    push block

% c-sdk {
static inline void uart_rx_program_init(PIO pio, uint sm, uint offset, uint pin_rx, uint baud) {
    pio_sm_config c = uart_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin_rx);
    sm_config_set_jmp_pin(&c, pin_rx);
    pio_gpio_init(pio, pin_rx);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_rx, 1, false);
    
    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);
    
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}